# Copia este archivo como .env para probar en local. En Cloudflare Pages se
# definen en Settings → Variables and Secrets. Ninguna es secreta (acaban en el HTML).

# URL pública de la web (sin barra final). Por defecto: https://mi-web.pages.dev
SITE_URL=

# Formulario de contacto (Web3Forms): https://api.web3forms.com/submit
PUBLIC_FORM_ENDPOINT=
# Clave de acceso de Web3Forms (es pública por diseño). Con Formspree, déjala vacía.
PUBLIC_FORM_ACCESS_KEY=

# Token de Cloudflare Web Analytics (sin cookies). Vacío = sin analítica.
PUBLIC_CF_ANALYTICS_TOKEN=
