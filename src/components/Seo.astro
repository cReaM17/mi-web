---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { SITIO } from '../data/sitio';

export interface SeoProps {
  titulo: string;
  descripcion: string;
  /** Imagen para redes sociales (se convierte a PNG 1200×630). */
  imagen?: ImageMetadata;
  imagenAlt?: string;
  tipo?: 'website' | 'article' | 'profile';
  noindex?: boolean;
}

const { titulo, descripcion, imagen, imagenAlt, tipo = 'website', noindex = false } =
  Astro.props as SeoProps;

const canonica = new URL(Astro.url.pathname, Astro.site);
let ogUrl = new URL('/og-default.png', Astro.site).href;
let ogAlt = 'Tarjeta de visita de DCM, David Clemente Martín, ingeniero de Telecomunicación';
if (imagen) {
  const og = await getImage({ src: imagen, format: 'png', width: 1200, height: 630, fit: 'cover' });
  ogUrl = new URL(og.src, Astro.site).href;
  ogAlt = imagenAlt ?? titulo;
}
---
<title>{titulo}</title>
<meta name="description" content={descripcion} />
<link rel="canonical" href={canonica.href} />
{noindex && <meta name="robots" content="noindex, follow" />}
<meta property="og:type" content={tipo} />
<meta property="og:locale" content="es_ES" />
<meta property="og:site_name" content={`${SITIO.marca} · ${SITIO.nombre}`} />
<meta property="og:title" content={titulo} />
<meta property="og:description" content={descripcion} />
<meta property="og:url" content={canonica.href} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogAlt} />
<meta name="twitter:card" content="summary_large_image" />
