---
/** Botón para alternar modo claro/oscuro. Sin JavaScript se sigue el modo del sistema. */
---
<button type="button" class="tema" data-tema-boton hidden>
  <svg class="tema__icono tema__icono--luna" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path>
  </svg>
  <svg class="tema__icono tema__icono--sol" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
  </svg>
  <span class="visualmente-oculto" data-tema-texto>Cambiar a modo oscuro</span>
</button>

<script>
  const boton = document.querySelector<HTMLButtonElement>('[data-tema-boton]');
  const texto = document.querySelector<HTMLElement>('[data-tema-texto]');
  const raiz = document.documentElement;
  const oscuroSistema = window.matchMedia('(prefers-color-scheme: dark)');

  const esOscuro = () =>
    raiz.dataset.theme ? raiz.dataset.theme === 'dark' : oscuroSistema.matches;

  const actualizar = () => {
    if (!boton || !texto) return;
    const oscuro = esOscuro();
    boton.dataset.oscuro = String(oscuro);
    texto.textContent = oscuro ? 'Cambiar a modo claro' : 'Cambiar a modo oscuro';
  };

  if (boton) {
    boton.hidden = false;
    boton.addEventListener('click', () => {
      const nuevo = esOscuro() ? 'claro' : 'oscuro';
      raiz.dataset.theme = nuevo === 'oscuro' ? 'dark' : 'light';
      try {
        localStorage.setItem('tema', nuevo);
      } catch {
        /* sin almacenamiento: el cambio dura hasta recargar */
      }
      actualizar();
    });
    oscuroSistema.addEventListener('change', actualizar);
    actualizar();
  }
</script>

<style>
  .tema {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid var(--c-borde);
    border-radius: 50%;
    background: var(--c-superficie);
    color: var(--c-acento);
    cursor: pointer;
  }
  .tema[hidden] {
    display: none;
  }
  .tema__icono {
    width: 1.25rem;
    height: 1.25rem;
  }
  .tema__icono--sol,
  .tema[data-oscuro='true'] .tema__icono--luna {
    display: none;
  }
  .tema[data-oscuro='true'] .tema__icono--sol {
    display: block;
  }
</style>
