---
import '@fontsource/barlow/600.css';
import '@fontsource/barlow/700.css';
import '@fontsource-variable/inter/wght.css';
import '../styles/global.css';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import barlowLatin700 from '@fontsource/barlow/files/barlow-latin-700-normal.woff2?url';
import Seo, { type SeoProps } from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import { personaJsonLd } from '../lib/jsonld';

interface Props extends SeoProps {
  /** Datos estructurados adicionales de la página. */
  jsonLd?: Record<string, unknown>[];
}

const { jsonLd = [], ...seo } = Astro.props;
const analytics = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN?.trim();
const site = Astro.site ?? new URL('https://mi-web.pages.dev');
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script src="/tema.js" is:inline></script>
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={barlowLatin700} as="font" type="font/woff2" crossorigin />
    <Seo {...seo} />
    <meta name="theme-color" content="#112E4E" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <JsonLd datos={[...personaJsonLd(site), ...jsonLd]} />
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {
      analytics && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: analytics })}
        />
      )
    }
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100dvh;
  }
  main:focus {
    outline: none;
  }
</style>
