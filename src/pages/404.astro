---
import Base from '../layouts/Base.astro';
import { SITIO } from '../data/sitio';
---
<Base
  titulo="Página no encontrada | DCM"
  descripcion="La página que buscas no existe o ha cambiado de dirección. Desde aquí puedes ir a los servicios, los proyectos o el contacto."
  noindex
>
  <section class="seccion">
    <div class="contenedor texto-largo">
      <span class="antetitulo">Error 404</span>
      <h1>Esta página no existe</h1>
      <p class="entradilla">
        Puede que la dirección esté mal escrita o que la página haya cambiado de sitio. Estas son las
        secciones principales:
      </p>
      <ul class="enlaces-404">
        <li><a href="/">Inicio</a></li>
        <li><a href="/servicios/">Servicios</a>: baja y media tensión, ICT, fotovoltaica, licencias y eficiencia energética</li>
        <li><a href="/proyectos/">Proyectos</a>: casos reales con su reto, su solución y su resultado</li>
        <li><a href="/contacto/">Contacto</a>: pide presupuesto</li>
      </ul>
      <p>
        ¿Buscabas algo en concreto? Escríbeme a <a href={`mailto:${SITIO.email}`}>{SITIO.email}</a> o llama al
        <a href={SITIO.telefonoEnlace}>{SITIO.telefono}</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .enlaces-404 li {
    padding-block: 0.3rem;
  }
</style>
